   "source": [
    "np.random.seed(19680801)\n",
    "data = np.random.random((50, 50, 50))\n",
    "\n",
    "fig, ax = plt.subplots()\n",
    "\n",
    "for i, img in enumerate(data):\n",
    "    ax.clear()\n",
    "    ax.imshow(img)\n",
    "    ax.set_title(f\"frame {i}\")\n",
    "    # Note that using time.sleep does *not* work here!\n",
    "    plt.pause(0.1)"
   ]
  },
  {
   "cell_type": "code",
