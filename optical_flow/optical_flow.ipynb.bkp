   "metadata": {},
   "outputs": [],
   "source": [
    "# gaussian filter as derivative\n",
    "\n",
    "fig, ax = plt.subplots(nrows=1, ncols=4, figsize=(15, 5))\n",
    "ax[0].imshow(\n",
    "    scipy.ndimage.gaussian_filter(\n",
    "        frames, sigma=1, order=[0, 0, 1], mode=\"constant\", cval=0.0\n",
    "    )[50],\n",
    "    cmap=\"gray\",\n",
    ")\n",
    "ax[0].set_title(\"Gaussian Filter Vx (Axis 2)\")\n",
    "\n",
    "ax[1].imshow(\n",
    "    scipy.ndimage.gaussian_filter(\n",
    "        frames, sigma=1, order=[0, 1, 0], mode=\"constant\", cval=0.0\n",
    "    )[50],\n",
    "    cmap=\"gray\",\n",
    ")\n",
    "ax[1].set_title(\"Gaussian Filter Vy (Axis 1)\")\n",
    "\n",
    "ax[2].imshow(\n",
    "    scipy.ndimage.gaussian_filter(\n",
    "        frames, sigma=1, order=[1, 0, 0], mode=\"constant\", cval=0.0\n",
    "    )[50],\n",
    "    cmap=\"gray\",\n",
    ")\n",
    "ax[2].set_title(\"Gaussian Filter Vt (Axis 0 / time)\")\n",
    "\n",
    "ax[3].imshow(frames[50], cmap=\"gray\")\n",
