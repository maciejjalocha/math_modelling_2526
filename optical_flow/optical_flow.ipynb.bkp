    "    cmap=\"gray\",\n",
    ")\n",
    "ax[2].set_title(\"Sobel Filter around time\")\n",
    "\n",
    "ax[3].imshow(frames[50], cmap=\"gray\")\n",
    "ax[3].set_title(\"Original Frame\")\n",
    "plt.show()"
   ]
