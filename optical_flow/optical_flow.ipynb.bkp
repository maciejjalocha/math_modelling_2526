   "source": [
    "# go over all pixels in the frame, with a stride of 5, and compute the flow vector for each selected pixel and plot\n",
    "t = 16\n",
    "N = 11\n",
    "stride = 20\n",
    "plt.figure(figsize=(10, 10))\n",
    "plt.imshow(frames[t], cmap=\"gray\")\n",
    "for y in range(N, frames[t].shape[0] - N, stride):\n",
    "    for x in range(N, frames[t].shape[1] - N, stride):\n",
    "        Vx_region = get_region_around(x, y, N, Vx[t])\n",
    "        Vy_region = get_region_around(x, y, N, Vy[t])\n",
    "        Vt_region = get_region_around(x, y, N, Vt[t])\n",
    "\n",
    "        A = np.hstack((Vx_region.reshape(-1, 1), Vy_region.reshape(-1, 1)))\n",
    "        b = -Vt_region.reshape(-1, 1)\n",
    "        flow_vector, _, _, _ = np.linalg.lstsq(A, b)\n",
    "        scaled_flow_vector = flow_vector.flatten() * 10\n",
    "        plt.quiver(\n",
    "            x,\n",
    "            y,\n",
    "            scaled_flow_vector[0],\n",
    "            scaled_flow_vector[1],\n",
    "            color=\"red\",\n",
    "            angles=\"xy\",\n",
    "            scale_units=\"xy\",\n",
    "            scale=1,\n",
    "        )\n",
    "plt.title(\"Estimated Flow Vectors\")\n",
    "plt.axis(\"off\")\n",
    "plt.show()"
   ]
