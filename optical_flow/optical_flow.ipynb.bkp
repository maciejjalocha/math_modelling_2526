    "    plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "8fa0649f",
   "metadata": {},
   "outputs": [],
   "source": [
    "# repeat for all frames (output all 64 images with flow vectors)\n",
    "\n",
    "for t in range(frames.shape[0]):\n",
    "    N = 21\n",
    "    stride = 20\n",
    "    plt.figure(figsize=(10, 10))\n",
    "    plt.imshow(frames[t], cmap=\"gray\")\n",
    "    for y in range(N, frames[t].shape[0] - N, stride):\n",
    "        for x in range(N, frames[t].shape[1] - N, stride):\n",
    "            Vx_region = get_region_around(x, y, N, Vx[t])\n",
    "            Vy_region = get_region_around(x, y, N, Vy[t])\n",
    "            Vt_region = get_region_around(x, y, N, Vt[t])\n",
    "\n",
    "            A = np.hstack((Vx_region.reshape(-1, 1), Vy_region.reshape(-1, 1)))\n",
    "            b = -Vt_region.reshape(-1, 1)\n",
    "            flow_vector, _, _, _ = np.linalg.lstsq(A, b)\n",
    "            scaled_flow_vector = flow_vector.flatten()\n",
    "            if (\n",
    "                np.linalg.norm(scaled_flow_vector) < 1\n",
    "            ):  # Only plot significant flow vectors\n",
    "                continue\n",
    "            plt.quiver(\n",
    "                x,\n",
    "                y,\n",
    "                scaled_flow_vector[0],\n",
    "                scaled_flow_vector[1],\n",
    "                color=\"red\",\n",
    "                angles=\"xy\",\n",
    "                scale_units=\"xy\",\n",
    "                scale=1,\n",
    "            )\n",
    "    plt.title(f\"Estimated Flow Vectors (Frame {t + 1})\")\n",
    "    plt.axis(\"off\")\n",
    "    plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "7bf005db",
   "metadata": {},
   "outputs": [],
   "source": [
    "# super fast lucas-kanade\n",
    "\n",
    "Vx2 = Vx * Vx\n",
    "Vy2 = Vy * Vy\n",
    "VxVy = Vx * Vy\n",
    "VxVt = Vx * Vt\n",
    "VyVt = Vy * Vt\n",
    "s = 2\n",
    "Sxx = scipy.ndimage.gaussian_filter(Vx2, sigma=s)\n",
    "Syy = scipy.ndimage.gaussian_filter(Vy2, sigma=s)\n",
    "Sxy = scipy.ndimage.gaussian_filter(VxVy, sigma=s)\n",
    "Sxt = scipy.ndimage.gaussian_filter(VxVt, sigma=s)\n",
    "Syt = scipy.ndimage.gaussian_filter(VyVt, sigma=s)\n",
    "\n",
    "det = Sxx * Syy - Sxy * Sxy\n",
    "u = -(Sxt * Syy - Syt * Sxy) / det\n",
    "v = -(Sxx * Syt - Sxy * Sxt) / det\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "00b27b7e",
   "metadata": {},
   "outputs": [],
   "source": [
    "# again, go through all frames and plot the flow vectors, with stride of 20\n",
    "\n",
    "for t in range(frames.shape[0]):\n",
    "    N = 21\n",
    "    stride = 20\n",
    "    plt.figure(figsize=(10, 10))\n",
    "    plt.imshow(frames[t], cmap=\"gray\")\n",
    "    for y in range(N, frames[t].shape[0] - N, stride):\n",
    "        for x in range(N, frames[t].shape[1] - N, stride):\n",
    "            flow_vector = np.array([u[t, y, x], v[t, y, x]]) * 10\n",
    "            if np.linalg.norm(flow_vector) < 1:  # Only plot significant flow vectors\n",
    "                continue\n",
    "            plt.quiver(\n",
    "                x,\n",
    "                y,\n",
    "                flow_vector[0],\n",
    "                flow_vector[1],\n",
    "                color=\"red\",\n",
    "                angles=\"xy\",\n",
    "                scale_units=\"xy\",\n",
    "                scale=1,\n",
    "            )\n",
    "    plt.title(f\"Estimated Flow Vectors (Frame {t + 1})\")\n",
    "    plt.axis(\"off\")\n",
    "    plt.show()"
   ]
