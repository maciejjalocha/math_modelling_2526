  {
   "cell_type": "markdown",
   "id": "b098f94b",
   "metadata": {},
   "source": [
    "### 3.1"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "38e0864a",
   "metadata": {},
   "outputs": [],
   "source": [
    "Vx = scipy.ndimage.gaussian_filter(frames, sigma=1, order=[0, 0, 1])\n",
    "Vy = scipy.ndimage.gaussian_filter(frames, sigma=1, order=[0, 1, 0])\n",
    "Vt = scipy.ndimage.gaussian_filter(frames, sigma=1, order=[1, 0, 0])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b0105f1f",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Simple:\n",
    "\n",
    "t = 30\n",
    "x, y = (100, 150)\n",
    "\n",
    "N = 5\n",
    "\n",
    "\n",
    "def get_region_around(x, y, N, arr):\n",
    "    \"\"\"Region centered around (x, y) with size NxN\"\"\"\n",
    "    return arr[y - N : y + N + 1, x - N : x + N + 1]\n",
    "\n",
    "\n",
    "Vx_region = get_region_around(x, y, N, Vx[t])\n",
    "Vy_region = get_region_around(x, y, N, Vy[t])\n",
    "Vt_region = get_region_around(x, y, N, Vt[t])\n",
    "\n",
    "A = np.hstack((Vx_region.reshape(-1, 1), Vy_region.reshape(-1, 1)))\n",
    "b = -Vt_region.reshape(-1, 1)\n",
    "# Solve for the flow vector (u, v) using least squares\n",
    "flow_vector, _, _, _ = np.linalg.lstsq(A, b)\n",
    "# print(\"Estimated flow vector (u, v):\", flow_vector"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c95340a6",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Plot the displacement vector on the original frame\n",
    "plt.figure()\n",
    "plt.imshow(frames[t], cmap=\"gray\")\n",
    "scaled_flow_vector = flow_vector.flatten() * 10  # Scale for better visualization\n",
    "plt.quiver(\n",
    "    x,\n",
    "    y,\n",
    "    scaled_flow_vector[0],\n",
    "    scaled_flow_vector[1],\n",
    "    color=\"red\",\n",
    "    angles=\"xy\",\n",
    "    scale_units=\"xy\",\n",
    "    scale=1,\n",
    ")\n",
    "plt.title(\"Estimated Flow Vector\")\n",
    "plt.axis(\"off\")\n",
    "plt.show()"
   ]
  },
