    "for i in range(frames.shape[0]):\n",
    "    ax.clear()\n",
    "    ax.imshow(frames[i], cmap=\"gray\")\n",
    "    ax.set_title(f\"Frame {i + 1}\")\n",
    "    plt.axis(\"off\")\n",
    "    plt.pause(0.1)"
   ]
